# ── gateway ───────────────────────────────────
# HTTP listen port (satu-satunya pintu masuk publik)
HTTP_PORT=8080

# Backend services (gRPC)
# Catatan: default kode memakai hostname gaya Docker (auth-service, room-service).
# Untuk run lokal tanpa Docker, ganti ke localhost seperti di bawah.
AUTH_SERVICE_ADDR=localhost:50051
ROOM_SERVICE_ADDR=localhost:50052
MUSIC_SERVICE_ADDR=localhost:50053

# Base URL frontend, dipakai untuk membangun invite link room private
WEB_BASE_URL=http://localhost:3000
RABBITMQ_URL=amqp://admin:admin123@localhost:5672/

